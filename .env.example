# Partenaire Dozie server — environment variables
# Copy to .env (local) or set in the Render service env.

# ── M-1 SECURITY (Sprint M-1) ───────────────────────────────────────
# REQUIRED. HS256 secret for Dozie session JWTs. MUST be a different
# value from the MP backend's ADMIN_JWT_SECRET / ADMIN_IMPERSONATE_SECRET
# (separate audience + revocation surface). Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DOZIE_JWT_SECRET=

# Optional. Dozie JWT lifetime in hours (default 24).
DOZIE_JWT_TTL_HOURS=24

# REQUIRED for the CamPay release/payout endpoints. The old hardcoded
# '2468' fallback was removed in M-1.3 — if this is unset those
# endpoints reject every request.
ADMIN_PIN=

# Dev-only OTP bypass. NEVER set both in production. When
# NODE_ENV=development AND ALLOW_DEV_OTP_BYPASS=1, /otp/verify also
# accepts the literal code "000000". Replaces the removed 2468 backdoor.
# ALLOW_DEV_OTP_BYPASS=

# ── PAYMENTS — CAMPAY (LAUNCH-PAYMENT-SECURITY) ─────────────────────
# Campay is the ONLY payment processor (Monetbil fully removed).
#
# REQUIRED. Must be exactly "production" in any production deployment —
# the server hard-exits on boot otherwise (no silent demo.campay).
CAMPAY_ENV=production
#
# REQUIRED — credentials. Provide EITHER a permanent access token
# (preferred) ...
CAMPAY_TOKEN=
# ... OR username + password (the server fetches a token):
# CAMPAY_USERNAME=
# CAMPAY_PASSWORD=
#
# REQUIRED. Webhook shared secret. Generate/copy it from the Campay
# dashboard (the app's "Webhook Key"), set the SAME value here and in
# Campay's webhook config. /campay/webhook rejects unsigned/forged
# callbacks with this; the server hard-exits on boot if it is missing
# in production.
CAMPAY_WEBHOOK_SECRET=
#
# REQUIRED in prod. Enables the fail-loud config checks above and must
# be "production" on Render.
NODE_ENV=production

# ── Other existing vars ─────────────────────────────────────────────
# ADMIN_IMPERSONATE_SECRET, MP_API_URL, etc. — see deployment notes.
# (Africa's Talking SMS + dev OTP bypass were removed in B.4.1.)
